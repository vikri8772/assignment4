# Copy this file to .env and change the values if your Neo4j is set up differently.
# .env is not committed. Never put a real password or API key in .env.example.

# Local Neo4j for development (see README.md).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ektemat-dev

# Optional: keeps people logged in when the server restarts.
# SECRET_KEY=
